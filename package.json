{
  "name": "wabisabi",
  "version": "1.0.0",
  "description": "Terminal IDE with agents - AI coding tool",
  "private": true,
  "workspaces": [
    "packages/*",
    "wabisabi-web-next"
  ],
  "scripts": {
    "build": "bun run build:terminal",
    "build:terminal": "cd packages/terminal && bun build",
    "dev": "cd packages/terminal && bun dev",
    "test": "bun test",
    "lint": "eslint ."
  },
  "keywords": [
    "ai",
    "coding",
    "terminal",
    "agents",
    "llm"
  ],
  "author": "Arkessiah",
  "license": "MIT",
  "packageManager": "bun@1.2.2",
  "overrides": {
    "serialize-javascript": ">=7.0.3",
    "minimatch": ">=9.0.5"
  },
  "devDependencies": {}
}
