{
  "name": "wabisabi-ai",
  "displayName": "WabiSabi AI",
  "description": "WabiSabi AI coding agent for VS Code — pairs with the WabiSabi CLI and your Substratum backend",
  "version": "0.1.0",
  "publisher": "wabisabi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arkessiah/wabisabi"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wabisabi.open",
        "title": "WabiSabi: Open Chat"
      },
      {
        "command": "wabisabi.settings",
        "title": "WabiSabi: Settings"
      },
      {
        "command": "wabisabi.switchAgent",
        "title": "WabiSabi: Switch Agent"
      },
      {
        "command": "wabisabi.switchModel",
        "title": "WabiSabi: Switch Model"
      },
      {
        "command": "wabisabi.switchStrategy",
        "title": "WabiSabi: Switch Strategy"
      },
      {
        "command": "wabisabi.onboarding",
        "title": "WabiSabi: Run Onboarding"
      },
      {
        "command": "wabisabi.account",
        "title": "WabiSabi: Account"
      },
      {
        "command": "wabisabi.explain",
        "title": "WabiSabi: Explain Selection"
      },
      {
        "command": "wabisabi.fix",
        "title": "WabiSabi: Fix Selection"
      },
      {
        "command": "wabisabi.test",
        "title": "WabiSabi: Generate Test"
      },
      {
        "command": "wabisabi.review",
        "title": "WabiSabi: Review Selection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wabisabi",
          "title": "WabiSabi",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "wabisabi": [
        {
          "type": "webview",
          "id": "wabisabi.chat",
          "name": "Chat"
        },
        {
          "id": "wabisabi.agents",
          "name": "Agents"
        },
        {
          "id": "wabisabi.tasks",
          "name": "Tasks"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "wabisabi.explain",
          "group": "wabisabi@1",
          "when": "editorHasSelection"
        },
        {
          "command": "wabisabi.fix",
          "group": "wabisabi@2",
          "when": "editorHasSelection"
        },
        {
          "command": "wabisabi.test",
          "group": "wabisabi@3",
          "when": "editorHasSelection"
        },
        {
          "command": "wabisabi.review",
          "group": "wabisabi@4",
          "when": "editorHasSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "wabisabi.open",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w"
      },
      {
        "command": "wabisabi.switchAgent",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ],
    "configuration": {
      "title": "WabiSabi",
      "properties": {
        "wabisabi.model": {
          "type": "string",
          "default": "llama3.2",
          "description": "Default AI model"
        },
        "wabisabi.providerStrategy": {
          "type": "string",
          "default": "hybrid-local-first",
          "enum": [
            "local",
            "cluster",
            "cloud",
            "cluster-cloud",
            "hybrid-local-first",
            "hybrid-cloud-first",
            "hybrid-full"
          ],
          "description": "Provider strategy"
        },
        "wabisabi.defaultAgent": {
          "type": "string",
          "default": "build",
          "enum": [
            "build",
            "plan",
            "search"
          ],
          "description": "Default agent"
        },
        "wabisabi.ollamaUrl": {
          "type": "string",
          "default": "",
          "description": "Ollama API URL (default: http://localhost:11434, or from ~/.wabisabi/config.jsonc)"
        },
        "wabisabi.substratumUrl": {
          "type": "string",
          "default": "",
          "description": "Substratum API URL (default: https://api.substratum.dev, or from ~/.wabisabi/config.jsonc)"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "clean": "rm -rf dist",
    "build": "bun run clean && node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "vscode:prepublish": "bun run build",
    "package": "bun run build && vsce package --no-dependencies --out wabisabi-ai.vsix"
  },
  "dependencies": {
    "@wabisabi/core": "file:../core"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  }
}
